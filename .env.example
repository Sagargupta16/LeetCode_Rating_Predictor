# Copy to .env and adjust values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration (exported artifacts; see scripts/export_model.py)
WEIGHTS_PATH=./models/weights.npz
SCALER_PATH=./models/scaler.json

# Reject predictions whose magnitude exceeds this (guards against bad inputs)
MAX_RATING_CHANGE=500

# Rate limiting (requests per window, per client IP)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache
REDIS_URL=
CACHE_TTL=300

# ML Artifact Downloads (for download_model.py)
MODEL_URL=
SCALER_URL=
GITHUB_TOKEN=
